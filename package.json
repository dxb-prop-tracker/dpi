{
  "name": "dubai-property-intelligence",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "seed": "tsx ingest/seed-sample.ts",
    "ingest:dld": "tsx ingest/ingest-dld.ts",
    "check:dld": "tsx ingest/ingest-dld.ts --check",
    "prepare:pulse": "tsx ingest/prepare-pulse.ts",
    "ingest:listings": "tsx ingest/ingest-listings.ts",
    "ingest:web": "tsx ingest/ingest-dldweb.ts",
    "ingest:register": "tsx ingest/ingest-register-extract.ts",
    "fix:obs": "tsx ingest/fix-obs-dates.ts && tsx ingest/ingest-dld.ts --only projects",
    "adapt:bayut": "tsx ingest/adapt-bayut-tracker.ts",
    "fetch:dda": "tsx ingest/fetch-dda.ts",
    "refresh": "tsx ingest/fetch-dda.ts --refresh && tsx ingest/ingest-dld.ts --only projects,developers,service_charges && npm run derive && npm run rsi && npm run avm && npm run moves && npm run supply && npm run check && npm run report && npm run issuer:data && npm run forecast && npm run credit:books && npm run build && npm run report:pdf",
    "migrate": "tsx ingest/migrate.ts",
    "report": "tsx ingest/build-report.ts",
    "report:pdf": "bash scripts/report-pdf.sh",
    "drops": "tsx ingest/detect-drops.ts",
    "derive": "tsx ingest/derive.ts && tsx ingest/derive-location.ts",
    "pipeline": "npm run ingest:dld && npm run derive && npm run ingest:listings && npm run drops",
    "go": "npm run prepare:pulse && npm run ingest:dld && npm run derive && npm run build && npm run dev",
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "deploy": "bash scripts/deploy-swa.sh",
    "azure:create": "bash scripts/azure.sh create",
    "invite": "bash scripts/azure.sh invite",
    "azure": "bash scripts/azure.sh",
    "fix:dups": "tsx ingest/fix-duplicates.ts",
    "check": "tsx ingest/selfcheck.ts",
    "issuer:data": "tsx ingest/issuer-data.ts",
    "credit:books": "bash scripts/credit-workbooks.sh",
    "forecast": "tsx ingest/forecast.ts",
    "avm": "tsx ingest/avm.ts",
    "moves": "tsx ingest/moves.ts",
    "supply": "tsx ingest/supply.ts",
    "rsi": "tsx ingest/rsi.ts",
    "ingest:permits": "tsx ingest/ingest-permits.ts",
    "test": "node --test tests/engine.test.mjs && python3 tests/xlsx_acceptance.py tests/fixtures/canonical.xlsx && python3 tests/escrow_parity.py tests/fixtures/canonical.xlsx",
    "preship": "bash scripts/preship.sh"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.3",
    "astro": "^5.18.2",
    "better-sqlite3": "^13.0.3",
    "csv-parse": "^7.0.2",
    "tsx": "^4.23.12",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {}
}
